# =================================================================
# QFlow Environment Variables Configuration
# =================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/qflow?retryWrites=true&w=majority
# Example Local MongoDB: mongodb://127.0.0.1:27017/qflow
MONGODB_URI=mongodb://127.0.0.1:27017/qflow

# JWT Authentication
JWT_SECRET=qflow_super_secure_jwt_secret_token_2026_qflow_mern
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=5

# AWS Cloud Integration Placeholders (Future-proof architecture)
# Ready for AWS S3, SES, and CloudWatch integration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_SES_FROM_EMAIL=
AWS_CLOUDWATCH_LOG_GROUP=
